{
  "name": "@deepseek-ai/dsh-client-ui-obsidian",
  "description": "Host-only Obsidian integration for DeepSeek Harness: 25 on-demand vault, knowledge, attachment, link, editor, and command tools with an authenticated local IPC companion.",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:companion": "tsc --noEmit -p tsconfig.companion.json",
    "test": "node scripts/test.mjs",
    "smoke:companion": "node scripts/smoke-companion.mjs",
    "build:companion": "node companion/build.mjs",
    "install:companion": "node scripts/install-companion.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run prepare && npm run verify:release",
    "prepublishOnly": "npm run typecheck && npm run check:companion && npm test"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.17.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "typescript": "~5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxpppp/dsh-obsidian.git"
  },
  "homepage": "https://github.com/gxpppp/dsh-obsidian#readme",
  "bugs": {
    "url": "https://github.com/gxpppp/dsh-obsidian/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "obsidian",
    "plugin",
    "knowledge-management",
    "agent-tools"
  ],
  "files": [
    "lib",
    "src",
    "scripts",
    "companion",
    "ARCHITECTURE.md",
    "MIGRATION.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "MIT"
}
